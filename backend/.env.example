# Environment Variables
PORT=3001
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Google Gemini Configuration (RECOMMENDED - Default AI Provider)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Configuration (Optional)
# Replace with your actual OpenAI API key to enable OpenAI as an AI provider
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter Configuration (Optional)
# Replace with your actual OpenRouter API key to enable OpenRouter as an AI provider
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic Claude Configuration (Optional)
# Replace with your actual Anthropic API key to enable Claude as an AI provider
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Front-end URL (for HTTP referer headers)
FRONTEND_URL=http://localhost:3000

# Back-end URL (for internal API calls)
BACKEND_URL=http://localhost:3001

# OpenRouter model for chat completions
OPENROUTER_MODEL=mistralai/mistral-7b-instruct

# Enhanced Educational Features Configuration
# These complement the existing RAG system with educational content generation
# OpenRouter model for educational content generation (quiz, flashcards, summaries)
OPENROUTER_EDUCATION_MODEL=deepseek/deepseek-r1-distill-llama-70b:free
# Preferred AI provider for educational content (leave empty to use default from ai-providers.json)
EDUCATION_AI_PROVIDER=

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf

# Application URL for referrer headers
APP_URL=http://localhost:3000

# CORS Configuration (enhanced)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003